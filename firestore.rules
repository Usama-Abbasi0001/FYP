rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isStudent() {
      return isSignedIn() && userDoc().role == 'student';
    }

    function isParent() {
      return isSignedIn() && userDoc().role == 'parent';
    }

    function isValidRole(role) {
      return role in ['admin', 'student', 'parent'];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isParent() && userId in userDoc().get('parentOf', []))
      );

      allow create: if isAdmin() &&
        isValidRole(request.resource.data.role) &&
        request.resource.data.role in ['student', 'parent'];

      allow update: if isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'loginId', 'createdByAdmin']));

      allow delete: if isAdmin();
    }

    match /studentLocations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStudent();
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
